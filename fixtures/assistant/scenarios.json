{
  "label": "synthetic",
  "version": "ask-scenarios-v1",
  "description": "Synthetic requests and scripted provider contract probes; not answer-quality labels. Invalid requests have null status and expected error.",
  "scenarios": [
    {
      "id": "dispatch-history",
      "input": {
        "question": "Why was ISS-001 sent to this responder?",
