{
  "name": "responsecompass",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Compass: context-aware responder recommendation agent",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env backend/src/server.mjs",
    "start": "node --env-file-if-exists=.env backend/src/server.mjs",
    "test": "node --test backend/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "measure:amd": "node --env-file-if-exists=.env scripts/measure-amd-models.mjs",
    "generate:history": "node scripts/generate-demo-history.mjs",
    "vendor": "node scripts/vendor-frontend.mjs",
    "eval:investigator": "node --env-file-if-exists=.env scripts/eval-investigator.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "dockview-core": "8.3.1"
  }
}
