# Compass environment configuration. Copy to .env (git-ignored). Every value is
# read server-side only and is never sent to the browser.

# --- Nebius Token Factory (fresh-install default) --------------------------
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TOKEN_FACTORY_API_KEY=
NEBIUS_TOKEN_FACTORY_API_KEY_FILE=
# Required until N0 verifies model IDs; blank means deterministic fallback.
NEBIUS_TOKEN_FACTORY_MODEL=
NEBIUS_TOKEN_FACTORY_EVENT_PLANNER_MODEL=
NEBIUS_TOKEN_FACTORY_INVESTIGATOR_MODEL=
NEBIUS_TOKEN_FACTORY_NARRATOR_MODEL=
# default omits thinking controls; on/off require a verified model capability entry.
NEBIUS_TOKEN_FACTORY_REASONING_EFFORT=default
NEBIUS_TOKEN_FACTORY_EVENT_PLANNER_REASONING_EFFORT=default
NEBIUS_TOKEN_FACTORY_INVESTIGATOR_REASONING_EFFORT=default
NEBIUS_TOKEN_FACTORY_NARRATOR_REASONING_EFFORT=default
NEBIUS_TOKEN_FACTORY_TIMEOUT_MS=90000
NEBIUS_TOKEN_FACTORY_EVENT_PLANNER_TIMEOUT_MS=30000
NEBIUS_TOKEN_FACTORY_INVESTIGATOR_TIMEOUT_MS=120000
NEBIUS_TOKEN_FACTORY_NARRATOR_TIMEOUT_MS=30000
NEBIUS_TOKEN_FACTORY_APP_RPM=20
NEBIUS_TOKEN_FACTORY_APP_CONCURRENCY=2
NEBIUS_TOKEN_FACTORY_MAX_RETRIES=2
NEBIUS_TOKEN_FACTORY_BREAKER_THRESHOLD=5
NEBIUS_TOKEN_FACTORY_BREAKER_COOLDOWN_MS=60000

# --- AMD Token Factory (retained selectable provider) ---------------------------
# OpenAI-compatible endpoint. See Compass_AMD_Token_Factory_Integration_Guide.md.
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Team-shared key (prefixed rc-). Set the key directly, or point to a file that
# contains only the key. The direct value wins if both are set. Never commit the
# key. Inside Docker, a host file path is not visible: set the key directly, or
# save it from the Settings tab instead.
AMD_TOKEN_FACTORY_API_KEY=
AMD_TOKEN_FACTORY_API_KEY_FILE=

# Seed model and reasoning level for a fresh install; the Settings tab can
# change both later (a saved selection takes precedence on later boots).
# MiMo-V2.6-Flash with reasoning "none" is the measured default. "default"
# leaves reasoning unset, which turns MiMo's thinking on.
AMD_TOKEN_FACTORY_MODEL=MiMo-V2.6-Flash
AMD_TOKEN_FACTORY_REASONING_EFFORT=none
# Optional planner-only seed overrides. A saved role selection wins on later boots.
AMD_TOKEN_FACTORY_EVENT_PLANNER_MODEL=
AMD_TOKEN_FACTORY_EVENT_PLANNER_REASONING_EFFORT=

# Output-token cap per call (reasoning tokens count against it). A reply that
# hits the cap is treated as a failure and falls back to the deterministic path.
AMD_TOKEN_FACTORY_MAX_OUTPUT_TOKENS=4096
# Local limits for all AMD calls in this process (agent + planner, every room).
# These are application budgets below AMD's own team limits (~30 RPM, 8 concurrent).
AMD_TOKEN_FACTORY_APP_RPM=10
AMD_TOKEN_FACTORY_APP_CONCURRENCY=2
# HTTP 429 retries (Retry-After honoured, within the caller's deadline).
AMD_TOKEN_FACTORY_MAX_RETRIES=2
# Circuit breaker: open after N consecutive service failures, probe after the cooldown.
AMD_TOKEN_FACTORY_BREAKER_THRESHOLD=5
AMD_TOKEN_FACTORY_BREAKER_COOLDOWN_MS=60000

# --- Inference modes ------------------------------------------------------
# Closed issue detail stays hot for this many simulated days (0 disables archiving).
# Exact observations and compact analytics facts remain available for all history.
COMPASS_HISTORY_RETENTION_DAYS=7

# live | fixture | force-failure, set independently for each model role.
COMPASS_EVENT_PLANNER_MODE=live
COMPASS_LIVE_COMPASS_MODE=live

# Per-role request timeouts (milliseconds). Optional; defaults are 30000 for the
# event planner and 90000 for the Compass agent (an AMD ranking takes about
# 25-60s, including one repair attempt). A call that exceeds the limit falls back to the deterministic path.
COMPASS_EVENT_PLANNER_TIMEOUT_MS=30000
COMPASS_AGENT_TIMEOUT_MS=90000

# Keep the deterministic local fallback available when inference is disabled or
# unavailable.
COMPASS_DEMO_INFERENCE_MODE=fixture
